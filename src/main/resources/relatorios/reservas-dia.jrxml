<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reservas-dia" pageWidth="842" pageHeight="595"
              orientation="Landscape"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <!-- Parâmetros -->
    <parameter name="dataFiltro"      class="java.lang.String"/>
    <parameter name="dataGeracao"     class="java.lang.String"/>
    <parameter name="totalRegistros"  class="java.lang.String"/>

    <!-- Campos do datasource (List<Map>) -->
    <field name="nomeCliente" class="java.lang.String"/>
    <field name="cpf"         class="java.lang.String"/>
    <field name="cidade"      class="java.lang.String"/>
    <field name="quarto"      class="java.lang.String"/>
    <field name="tipo"        class="java.lang.String"/>
    <field name="dias"        class="java.lang.String"/>
    <field name="precoDia"    class="java.lang.String"/>
    <field name="total"       class="java.lang.String"/>

    <title>
        <band height="70">

            <staticText>
                <reportElement x="0" y="0" width="762" height="26"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATORIO DE RESERVAS POR DIA]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="28" width="762" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Data: " + $P{dataFiltro} + "   |   Total de registros: " + $P{totalRegistros}]]></textFieldExpression>
            </textField>

            <line><reportElement x="0" y="46" width="762" height="1"/></line>

            <!-- Cabeçalho da tabela -->
            <staticText>
                <reportElement x="0" y="50" width="160" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="50" width="90" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[CPF]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="50" width="100" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Cidade]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="50" width="80" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Quarto]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="50" width="100" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement x="530" y="50" width="50" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Dias]]></text>
            </staticText>
            <staticText>
                <reportElement x="580" y="50" width="91" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Preco/Dia]]></text>
            </staticText>
            <staticText>
                <reportElement x="671" y="50" width="91" height="16" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="160" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[" " + $F{nomeCliente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="90" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{cpf}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="100" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{cidade}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="0" width="80" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quarto}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="100" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="530" y="0" width="50" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dias}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="0" width="91" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["R$ " + $F{precoDia}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="671" y="0" width="91" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["R$ " + $F{total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="762" height="20"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Nenhuma reserva encontrada para esta data.]]></text>
            </staticText>
        </band>
    </noData>

    <summary>
        <band height="20">
            <textField>
                <reportElement x="0" y="4" width="762" height="12"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{dataGeracao} + "  |  HotelSys - FATEC ZL"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
